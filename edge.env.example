# Remote orchestrator URL served by the VPS.
ELOWEN_API_URL=https://api.ericburden.dev

# NATS is expected to arrive through a local SSH tunnel.
ELOWEN_NATS_URL=nats://127.0.0.1:4222

# Device identity shown in the orchestrator.
ELOWEN_DEVICE_ID=elowen-laptop
ELOWEN_DEVICE_NAME=Elowen Laptop
ELOWEN_DEVICE_PRIMARY=true

# Repository and capability declarations sent during registration.
ELOWEN_ALLOWED_REPO_ROOTS=D:\Projects
# Optional explicit repo-name overlay for supplements or exceptions.
ELOWEN_ALLOWED_REPOS=elowen-api
ELOWEN_DEVICE_CAPABILITIES=codex,git,build,test,generic_jobs

# Optional trusted registration with strict orchestrator key pinning.
# Pin one or more trusted orchestrator public keys and provide this edge's
# private signing key as base64url-no-pad Ed25519 key material.
# Generate compatible keypairs with:
# elowen-edge --generate-trust-keypair
#
# Legacy single-key pin:
# ELOWEN_ORCHESTRATOR_PUBLIC_KEY=
#
# Comma-separated pin set for orchestrator trust rotation:
# ELOWEN_ORCHESTRATOR_PUBLIC_KEYS=
#
# Preferred structured pin set when the API publishes key ids:
# ELOWEN_TRUSTED_ORCHESTRATOR_KEYS_JSON=[{"key_id":"current","public_key":"..."},{"key_id":"next","public_key":"..."}]
#
# Current edge signing key:
# ELOWEN_EDGE_SIGNING_KEY=
#
# Optional previous edge signing key for trusted re-enrollment after key rotation.
# When set, the edge will attach both current and previous key proofs so the API
# can treat the registration as an explicit key replacement rather than a new device.
# ELOWEN_PREVIOUS_EDGE_SIGNING_KEY=

# Local checkout and worktree paths on the laptop.
ELOWEN_EDGE_WORKSPACE_ROOT=D:\Projects\elowen
ELOWEN_EDGE_WORKTREE_ROOT=D:\Projects\elowen\.elowen\worktrees

# Optional real Codex runner and logging overrides.
# ELOWEN_CODEX_COMMAND=codex
# ELOWEN_CODEX_ARGS_JSON=["--model","gpt-5.4"]
# ELOWEN_SANDBOX_MODE=workspace
# ELOWEN_LOG_FORMAT=json
# RUST_LOG=info
